# syntax=docker/dockerfile:1
FROM node:22.15.0-alpine AS build
WORKDIR /src
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ .
COPY ops/nginx.conf ./nginx.conf
COPY scripts/configure-web-proxy.mjs ./configure-web-proxy.mjs
ARG VITE_API_URL=
ARG VITE_GITHUB_URL=https://github.com/willunylabs/amsonia-core
ARG VITE_COMMERCIAL_URL=https://amsonia.dev/platform/
ENV VITE_API_URL=$VITE_API_URL \
    VITE_GITHUB_URL=$VITE_GITHUB_URL \
    VITE_COMMERCIAL_URL=$VITE_COMMERCIAL_URL
RUN node configure-web-proxy.mjs nginx.conf && npm run build

FROM nginx:1.28-alpine
COPY --from=build /src/nginx.conf /etc/nginx/conf.d/default.conf
COPY ops/nginx-security-headers.conf /etc/nginx/includes/security-headers.conf
COPY --from=build /src/dist /usr/share/nginx/html
EXPOSE 8080
