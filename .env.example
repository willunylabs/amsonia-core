# Migration CLI: database owner. Never use this DSN for the running API.
AMSONIA_MIGRATION_DSN=postgres://db_owner@127.0.0.1:5432/amsonia_core?sslmode=disable

# Operator shell only: a cluster role administrator used by the provisioning
# SQL. Never expose this connection to the API or web process.
AMSONIA_ROLE_ADMIN_DSN=postgres://role_admin@127.0.0.1:5432/amsonia_core?sslmode=disable

# Runtime API: non-superuser, non-owner, no BYPASSRLS.
AMSONIA_DATABASE_DSN=host=127.0.0.1 port=5432 dbname=amsonia_core user=amsonia_runtime sslmode=disable
PGPASSWORD=CHANGE_ME_RUNTIME_ROLE_PASSWORD
AMSONIA_TENANT_BINDING_SECRET=CHANGE_ME_UNPADDED_BASE64URL
AMSONIA_HTTP_ADDR=:8080

# Local Vite development only.
VITE_API_PROXY_TARGET=http://127.0.0.1:8080
# Build-time path prefix only (for example `/backend`); it must stay same-origin.
VITE_API_URL=

# Optional Compose delivery. Generate independent values with
# `openssl rand -hex 32`; AMSONIA_TENANT_BINDING_SECRET must be the unpadded
# base64url representation of the exact bytes in AMSONIA_RUNTIME_SECRET_HEX.
AMSONIA_POSTGRES_OWNER_PASSWORD=CHANGE_ME_OWNER_PASSWORD
AMSONIA_POSTGRES_RUNTIME_PASSWORD=CHANGE_ME_RUNTIME_PASSWORD
AMSONIA_POSTGRES_MAINTENANCE_PASSWORD=CHANGE_ME_MAINTENANCE_PASSWORD
AMSONIA_RUNTIME_SECRET_HEX=CHANGE_ME_64_OR_MORE_HEX_CHARACTERS
AMSONIA_MAINTENANCE_SECRET_HEX=CHANGE_ME_DIFFERENT_64_OR_MORE_HEX_CHARACTERS
AMSONIA_WEB_PORT=8080
