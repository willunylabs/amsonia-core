---
import { COMPANY_ORIGIN, COMMERCIAL_URL, GITHUB_URL } from '../lib/site';
---

<footer class="site-footer">
  <div class="footer-lead">
    <a class="footer-brand" href="/" aria-label="Amsonia home">
      <img src="/amsonia-mark-v2.svg" width="34" height="34" alt="" />
      <span>Amsonia</span>
    </a>
    <p>Choose the SaaS foundation that fits your stack, then own the source and the next decision.</p>
  </div>
  <div class="footer-grid">
    <div>
      <strong>Products</strong>
      <a href="/platform/">Amsonia Platform</a>
      <a href="/next/">Amsonia Next</a>
      <a href="/compare/platform-vs-next/">Compare products</a>
    </div>
    <div>
      <strong>Resources</strong>
      <a href="/docs/">Documentation</a>
      <a href="/open-source/">Open source</a>
      <a href={GITHUB_URL} data-cta-target="github">Engineering on GitHub ↗</a>
    </div>
    <div>
      <strong>Published by</strong>
      <a href={COMPANY_ORIGIN}>Willuny Labs ↗</a>
      <a href={`${COMPANY_ORIGIN}/shop/contact`}>Contact ↗</a>
      <a href="/about/">About Amsonia</a>
    </div>
  </div>
  <div class="footer-base">
    <span>© {new Date().getFullYear()} Willuny Labs LLC</span>
    <a href={COMPANY_ORIGIN}>A Willuny Labs product ↗</a>
  </div>
</footer>
