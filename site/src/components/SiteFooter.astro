---
import { COMPANY_ORIGIN, COMMERCIAL_URL, DEMO_URL, GITHUB_URL } from '../lib/site';
---

<footer class="site-footer">
  <div class="footer-lead">
    <a class="footer-brand" href="/" aria-label="Amsonia home">
      <img src="/amsonia-mark-v2.svg" width="34" height="34" alt="" />
      <span>Amsonia</span>
    </a>
    <p>Production-grade Go infrastructure with explicit boundaries, public evidence, and source your team can own.</p>
  </div>
  <div class="footer-grid">
    <div>
      <strong>Explore</strong>
      <a href="/core">Amsonia Core</a>
      <a href="/docs">Documentation</a>
      <a href="/releases">Releases</a>
    </div>
    <div>
      <strong>Evaluate</strong>
      <a href={GITHUB_URL} data-cta-target="github">GitHub ↗</a>
      <a href={DEMO_URL} data-cta-target="demo">Live demo ↗</a>
      <a href={COMMERCIAL_URL} data-cta-target="commercial">Amsonia Source Distribution ↗</a>
    </div>
    <div>
      <strong>Published by</strong>
      <a href={COMPANY_ORIGIN}>Willuny Labs ↗</a>
      <a href={`${COMPANY_ORIGIN}/shop/contact`}>Contact Willuny ↗</a>
      <span>Apache-2.0 Core</span>
    </div>
  </div>
  <div class="footer-base">
    <span>© {new Date().getFullYear()} Willuny Labs LLC</span>
    <a href={COMPANY_ORIGIN}>A Willuny Labs product ↗</a>
  </div>
</footer>
