---
import TopicPage from '../../components/TopicPage.astro';
import { breadcrumbSchema } from '../../lib/site';
const description = 'Review the Amsonia role-based access control model: tenant membership, roles, permissions, server-side enforcement, delegated administration, and audit evidence.';
---
<TopicPage eyebrow="Platform capability" index="FEATURE / 02" title="RBAC belongs at the protected action" summary="Navigation can reflect permissions, but only the server can authorize a change. Amsonia keeps membership, roles, permissions, and audit evidence explicit." description={description} canonicalPath="/features/rbac" schemas={[breadcrumbSchema([{ name: 'Amsonia', href: '/' }, { name: 'Platform', href: '/platform' }, { name: 'RBAC', href: '/features/rbac' }])]}
  sections={[
    { id: 'model', title: 'Separate membership from permission', paragraphs: ['Tenant membership answers where an identity may operate. Roles and permissions answer what actions are permitted inside that boundary. Keeping the concepts separate makes product rules easier to review and test.', 'Permission names should describe stable business actions rather than individual buttons or routes. Interface changes then do not silently redefine the authorization model.'] },
    { id: 'server', title: 'Enforce every protected action', paragraphs: ['The Go API rechecks authorization for protected operations. A hidden button, disabled form, or protected Next.js route improves the user experience but is never the security decision.', 'Background jobs, support tools, and integrations need the same explicit authorization and tenant rules as browser-driven requests.'] },
    { id: 'delegation', title: 'Bound delegated administration', paragraphs: ['Tenant administrators can manage access only within the delegation rules assigned to them. Role inheritance and administration need cycle prevention, privilege ceilings, and tests for attempted escalation.', 'Global operators remain a separate operational boundary rather than an invisible super-role inside every customer tenant.'] },
    { id: 'evidence', title: 'Make policy changes auditable', paragraphs: ['Role definitions, permission catalogs, assignments, and authorization-sensitive changes should produce evidence that operators can inspect. Append-only policy events help explain how access changed over time.', 'Platform keeps the authorization contract and security assumptions explicit so product teams can review changes alongside the operations they protect.'] }
  ]}
  relatedLinks={[{ href: '/platform/', label: 'Amsonia Platform', description: 'See RBAC inside the full product foundation.' }, { href: '/architecture/', label: 'Architecture', description: 'Review the server-side enforcement boundary.' }, { href: '/features/multi-tenancy/', label: 'Multi-tenancy', description: 'See where authorization takes effect.' }, { href: '/security/', label: 'Security boundary', description: 'Understand the wider control model.' }]}
/>
