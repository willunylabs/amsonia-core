---
import PageIntro from '../components/PageIntro.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbSchema, COMMERCIAL_URL } from '../lib/site';

const description = 'Learn how the Amsonia product family separates commercial SaaS foundations, open-source products, public evidence, and Willuny Labs as publisher.';
---

<BaseLayout title="About Amsonia" description={description} canonicalPath="/about" schemas={[breadcrumbSchema([{ name: 'Amsonia', href: '/' }, { name: 'About', href: '/about' }])]}>
  <main id="main-content">
    <PageIntro eyebrow="Product family and publisher" index="ABOUT / 00" title="About Amsonia" summary="Amsonia is the product family from Willuny Labs. Platform serves multi-tenant Go teams, while Next serves builders who want an open-source Next.js foundation." />
    <div class="content-shell">
      <div class="content-grid">
        <aside class="content-aside"><nav aria-label="About sections"><a href="#brand">Brand</a><a href="#principles">Principles</a><a href="#publisher">Publisher</a></nav></aside>
        <article class="prose">
          <h2 id="brand">One family. Distinct products.</h2>
          <p>Amsonia groups source-owned product foundations under one name without pretending every buyer needs the same stack. Platform is the commercial Go + Next.js system for multi-tenant B2B products. Next is the open-source Next.js starting point.</p>
          <h2 id="principles">Claims follow evidence.</h2>
          <ul><li>Published capabilities map to code, tests, contracts, or maintained documentation.</li><li>Open-source and commercial boundaries remain visible.</li><li>Product pages appear after release readiness, not as thin roadmap placeholders.</li><li>Technical learning lives here; purchase and company information live at Willuny.</li></ul>
          <h2 id="publisher">Published by Willuny Labs.</h2>
          <p>Willuny Labs is the company, publisher, seller, and support owner. This site owns product explanation and technical evaluation; transaction and company surfaces remain explicitly connected to Willuny Labs.</p>
          <div class="hero-actions"><a class="button primary" href={COMMERCIAL_URL} data-cta-target="commercial">View source packages ↗</a><a class="button secondary" href="/products/">Compare Amsonia products →</a></div>
        </article>
      </div>
    </div>
  </main>
</BaseLayout>
