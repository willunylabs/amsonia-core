---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import WebsiteArtwork from '../../components/WebsiteArtwork.astro';
import FeatureArtwork from '../../components/FeatureArtwork.astro';
import { breadcrumbSchema, COMMERCIAL_URL, softwareProductSchema } from '../../lib/site';

const description = 'Amsonia Platform is a commercial Go and Next.js SaaS starter kit with multi-tenant boundaries, RBAC, billing, administration, and source ownership.';
const schema = softwareProductSchema({ name: 'Amsonia Platform', path: '/platform', description, license: 'Commercial source license', isAccessibleForFree: false });
---

<BaseLayout title="Go + Next.js SaaS Platform" description={description} canonicalPath="/platform" schemas={[schema, breadcrumbSchema([{ name: 'Amsonia', href: '/' }, { name: 'Platform', href: '/platform' }])]}>
  <main id="main-content">
    <PageIntro eyebrow="Amsonia Platform / Commercial source" index="PLATFORM / 01" title="A Go + Next.js foundation for multi-tenant SaaS." summary="Buy the source, adapt the product, and deploy it on infrastructure you control. Platform connects the application layer technical teams repeatedly rebuild before customer work can begin.">
      <WebsiteArtwork slot="artwork" variant="platform" />
    </PageIntro>
    <div class="content-shell">
      <section class="section compact-section"><div class="metric-grid"><div><FeatureArtwork name="source" /><span>Backend</span><strong>Go</strong><p>Business rules and protected operations.</p></div><div><FeatureArtwork name="operations" /><span>Frontend</span><strong>Next.js</strong><p>Public, account, and operations surfaces.</p></div><div><FeatureArtwork name="tenancy" /><span>Tenancy</span><strong>Multi-tenant</strong><p>Tenant and workspace-aware boundaries.</p></div><div><FeatureArtwork name="deploy" /><span>Delivery</span><strong>Source code</strong><p>Customize and operate the system yourself.</p></div></div></section>
      <section class="section split-section"><div><span class="eyebrow">What is included</span><h2>The recurring SaaS layer, connected.</h2></div><div class="stack-list"><article><FeatureArtwork name="tenancy" class="stack-artwork" /><h3>Identity and tenancy</h3><p>Customer accounts, organizations, workspaces, memberships, and trusted tenant context.</p></article><article><FeatureArtwork name="identity" class="stack-artwork" /><h3>Authorization</h3><p>Server-enforced roles and permissions with explicit customer and operator boundaries.</p></article><article><FeatureArtwork name="billing" class="stack-artwork" /><h3>Commerce and billing</h3><p>Stripe-oriented checkout, payments, subscriptions, invoices, webhooks, and fulfillment surfaces.</p></article><article><FeatureArtwork name="operations" class="stack-artwork" /><h3>Product operations</h3><p>Administrative workflows for users, tenants, access, commerce, content, and system settings.</p></article></div></section>
      <section class="section band inset-band"><div class="section-heading"><span class="eyebrow">Ownership boundary</span><div class="section-heading-copy"><h2>It is not hosted SaaS.</h2><p>Platform is a source-code application foundation. It is not a no-code builder, managed hosting service, compliance guarantee, or an open-ended implementation engagement. Your team configures its providers, extends domain rules, and operates the deployed product.</p></div></div><div class="hero-actions"><a class="button primary" href={COMMERCIAL_URL} data-cta-target="commercial">View source packages ↗</a><a class="button secondary" href="/platform/docs/">Read the evaluation guide →</a><a class="button quiet" href="/compare/platform-vs-next/">Compare with Next →</a></div></section>
      <section class="related-section"><span class="eyebrow">Technical evaluation</span><h2>Inspect the boundaries before buying.</h2><div class="link-grid"><a class="link-card" href="/architecture/"><span>ARCH / 01</span><h3>Architecture</h3><p>Understand runtimes, data flow, deployment, and the modular-monolith boundary.</p></a><a class="link-card" href="/features/multi-tenancy/"><span>TENANT / 02</span><h3>Multi-tenancy</h3><p>Trace tenant context through access, jobs, caches, and protected resources.</p></a><a class="link-card" href="/features/stripe-billing/"><span>BILLING / 03</span><h3>Stripe billing</h3><p>Review checkout, webhook, ledger, subscription, and fulfillment responsibilities.</p></a><a class="link-card" href="/security/"><span>SEC / 04</span><h3>Security</h3><p>See the controls supplied by the foundation and the controls buyers still own.</p></a></div></section>
    </div>
  </main>
</BaseLayout>
