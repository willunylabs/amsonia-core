---
import TopicPage from '../../../components/TopicPage.astro';
import { breadcrumbSchema } from '../../../lib/site';
const description = 'Review the Amsonia Platform deployment boundary for its Next.js frontend, Go API, PostgreSQL, secrets, migrations, observability, backups, health checks, and rollback.';
---
<TopicPage eyebrow="Platform docs / Deployment" index="DOC / 02" title="Deploy an owned two-runtime system" summary="Platform separates edge-friendly Next.js surfaces from stateful Go and PostgreSQL operations. The source is delivered; production ownership stays with the buyer." description={description} canonicalPath="/platform/docs/deployment" schemas={[breadcrumbSchema([{ name: 'Amsonia', href: '/' }, { name: 'Platform', href: '/platform' }, { name: 'Docs', href: '/platform/docs' }, { name: 'Deployment', href: '/platform/docs/deployment' }])]}
  sections={[
    { id: 'topology', title: 'Choose the production topology', paragraphs: ['The reference boundary deploys Next.js surfaces separately from the Go API and PostgreSQL. Buyers may adapt providers, but browser requests should continue through the approved application boundary and server-only credentials must remain server-side.', 'Record canonical public, transaction, API, and callback origins explicitly. Domain aliases and environment fallbacks are not a substitute for production configuration.'] },
    { id: 'secrets', title: 'Isolate identities and secrets', paragraphs: ['Use distinct deployment identities with the minimum permissions needed for frontend delivery, backend release, artifacts, and database migration. Store OAuth, email, payment, database, and cloud credentials in the environment’s secret system.', 'Production secrets must not enter build logs, browser bundles, screenshots, test fixtures, or repository history.'] },
    { id: 'release', title: 'Release immutable artifacts', paragraphs: ['Build from a reviewed commit, identify the artifact with that revision, verify integrity before activation, and keep the previous release available for rollback.', 'Database migrations require an explicit compatibility and rollback plan. Application rollback cannot undo an incompatible data change by itself.'] },
    { id: 'operations', title: 'Own health, recovery, and evidence', paragraphs: ['Monitor frontend availability, API health, worker health, database capacity, provider webhooks, queues, and product-level failures. Backups are only useful after a restore exercise proves they can recover the system.', 'Document alert ownership, incident response, credential rotation, maintenance windows, and rollback verification before accepting production traffic.'] }
  ]}
  relatedLinks={[{ href: '/architecture/', label: 'Architecture', description: 'Understand why the runtimes are separated.' }, { href: '/platform/docs/quickstart/', label: 'Quickstart', description: 'Establish a clean local baseline.' }, { href: '/security/', label: 'Security', description: 'Review deployment control ownership.' }, { href: '/platform/roadmap/', label: 'Roadmap', description: 'See current product direction.' }]}
/>
