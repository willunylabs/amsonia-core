---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { breadcrumbSchema, COMMERCIAL_URL, COMPANY_CONTACT_URL } from '../lib/site';
const description = 'Understand Amsonia pricing: Amsonia Next is privately maintained, while Amsonia Platform is sold through commercial source-code packages by Willuny Labs.';
---
<BaseLayout title="Amsonia Pricing" description={description} canonicalPath="/pricing" schemas={[breadcrumbSchema([{ name: 'Amsonia', href: '/' }, { name: 'Pricing', href: '/pricing' }])]}>
  <main id="main-content">
    <PageIntro eyebrow="Pricing and distribution" index="PRICE / 01" title="Availability and commercial source" summary="Contact Willuny Labs about Amsonia Next source availability and terms. Amsonia Platform has a separate commercial package catalog." />
    <div class="content-shell">
      <section class="section"><div class="product-grid">
        <article class="product-card product-card-featured"><span class="specimen-number">AMSONIA NEXT / PRIVATE SOURCE</span><h2>Ask about Next</h2><p class="product-lede">Authentication, Stripe billing, PostgreSQL, and admin in one privately maintained Next.js application. Contact Willuny Labs to confirm source availability, pricing, license rights, and support.</p><div class="hero-actions"><a class="button primary" href="/next/">Explore Next →</a><a class="button secondary" href={COMPANY_CONTACT_URL}>Contact Willuny Labs ↗</a></div></article>
        <article class="product-card"><span class="specimen-number">AMSONIA PLATFORM / COMMERCIAL</span><h2>Source packages</h2><p class="product-lede">Platform is purchased under a commercial source license. Package price, repository access, permitted users, updates, support, and fulfillment are defined in the current catalog.</p><div class="hero-actions"><a class="button primary" href={COMMERCIAL_URL} data-cta-target="commercial">View current packages ↗</a><a class="button secondary" href="/platform/docs/">Evaluate first →</a></div></article>
      </div></section>
      <section class="publication-note"><span class="eyebrow">Before purchase</span><h2>Price is only one boundary.</h2><p>Confirm the product fit, license rights, included repositories or artifacts, update period, support scope, and buyer responsibilities. A source package does not include managed hosting or unlimited implementation unless the selected offer explicitly says so.</p></section>
    </div>
  </main>
</BaseLayout>
