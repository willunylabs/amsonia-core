---
import TopicPage from '../components/TopicPage.astro';
import { breadcrumbSchema, COMPANY_CONTACT_URL, COMMERCIAL_URL } from '../lib/site';
const description = 'Review Amsonia Next source access, current purchase options, and the contact path for questions about licensing, delivery, and support.';
---
<TopicPage eyebrow="Amsonia Next" index="ACCESS / 01" title="Source access and pricing." summary="Review current purchase options for Amsonia Next or contact Willuny Labs about your requirements." description={description} canonicalPath="/pricing" schemas={[breadcrumbSchema([{ name: 'Amsonia', href: '/' }, { name: 'Pricing', href: '/pricing' }])]}
  sections={[
    { id: 'source', title: 'Amsonia Next source access', paragraphs: ['Review the current purchase page for pricing and source access.', 'Contact Willuny Labs to confirm included source, license rights, delivery, updates, and support.'] }
  ]}
  relatedLinks={[{ href: '/next/', label: 'Amsonia Next', description: 'Explore the Next.js SaaS starter.' }, { href: '/license/', label: 'Source access and licensing', description: 'Review licensing information.' }, { href: COMMERCIAL_URL, label: 'Buy Amsonia Next', description: 'Review current purchase options.' }, { href: COMPANY_CONTACT_URL, label: 'Contact Willuny Labs', description: 'Discuss source access and your requirements.' }]}
/>
