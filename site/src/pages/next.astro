---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { COMPANY_CONTACT_URL, absoluteUrl, breadcrumbSchema, softwareProductSchema } from '../lib/site';

const description = 'A private Next.js SaaS starter with Stripe billing, PostgreSQL, Drizzle, account management, and admin. Evaluate the stack and source access with Willuny Labs.';
const schema = softwareProductSchema({ name: 'Amsonia Next', path: '/next', description, license: absoluteUrl('/license') });
const questions = [
  { question: 'What does this Next.js SaaS starter include?', answer: 'A full-stack TypeScript application with account management, Stripe checkout and subscriptions, PostgreSQL through Drizzle, administration, and marketing and content pages. Start with these shared flows and add your product logic.' },
  { question: 'Do I need a separate Go backend?', answer: 'Next keeps application routes, server-side logic, and UI in one Next.js codebase. You still configure PostgreSQL and the external services your application uses. Amsonia Platform is the separate Go + Next.js product.' },
  { question: 'Is Amsonia Next open source?', answer: 'Next is a privately maintained commercial product. Contact Willuny Labs to confirm source access, delivery, licensing, updates, and support. The Apache-2.0 Go repository has its own scope and does not include the Next source.' },
  { question: 'Does Next include customer organizations and tenant isolation?', answer: 'The current Next product is single-tenant. If you need customer organizations, workspace isolation, and a separate Go service, evaluate Amsonia Platform against those requirements.' }
];
---

<BaseLayout title="Amsonia Next — Next.js SaaS Starter Kit" description={description} canonicalPath="/next" schemas={[schema, breadcrumbSchema([{ name: 'Amsonia', href: '/' }, { name: 'Next', href: '/next' }])]}>
  <main id="main-content">
    <PageIntro eyebrow="Next.js SaaS starter kit / Private source" index="NEXT / 01" title="Your SaaS starts with one Next.js codebase." summary="Bring authentication, Stripe billing, PostgreSQL, and admin together in one Next.js 16 application. Build your product on a full-stack TypeScript foundation with Drizzle for data access." />
    <div class="content-shell">
      <div class="hero-actions"><a class="button primary" href={COMPANY_CONTACT_URL} data-cta-target="contact">Ask about source access ↗</a><a class="button secondary" href="#capabilities">Explore capabilities ↓</a></div>
      <section class="section compact-section" aria-label="Application stack"><div class="metric-grid"><div><span>Framework</span><strong>Next.js 16</strong><p>App Router and full-stack TypeScript.</p></div><div><span>Data</span><strong>PostgreSQL</strong><p>Drizzle schemas and explicit migrations.</p></div><div><span>Identity</span><strong>Accounts</strong><p>Registration, recovery, and session management.</p></div><div><span>Availability</span><strong>Private source</strong><p>Confirm delivery and license terms with Willuny Labs.</p></div></div></section>
      <section class="section split-section" id="capabilities"><div><span class="eyebrow">Included features</span><h2>A SaaS boilerplate for the whole application.</h2><p>Keep accounts, subscriptions, and administration in the same codebase as the features your customers use.</p></div><div class="stack-list"><article><span>01</span><h3>Account management</h3><p>Registration, login, password recovery, email verification, sessions, data export, and account deletion.</p></article><article><span>02</span><h3>Stripe subscriptions and checkout</h3><p>Checkout, subscriptions, a customer billing portal, webhooks, and payment records.</p></article><article><span>03</span><h3>PostgreSQL with Drizzle</h3><p>Work with database schemas and migrations in TypeScript alongside the application that uses them.</p></article><article><span>04</span><h3>Administration</h3><p>Admin pages, subscription management, audit logs, and role-based access.</p></article><article><span>05</span><h3>Marketing and content</h3><p>Localized pages, an MDX blog, metadata, sitemap, robots.txt, and Open Graph images.</p></article></div></section>
      <section class="publication-note"><span class="eyebrow">Who it fits</span><h2>A focused product. One application to extend.</h2><p>Amsonia Next suits founders and small teams building a single-tenant SaaS or paid web application. Choose it when you want PostgreSQL, Drizzle, Stripe, and full-stack TypeScript together. Review the current scope with us before deciding on source access.</p><div class="hero-actions"><a class="button primary" href={COMPANY_CONTACT_URL} data-cta-target="contact">Discuss your Next.js project ↗</a><a class="button secondary" href="/compare/shipfast-vs-amsonia-next/">Compare with ShipFast →</a></div></section>
      <section class="section split-section" aria-labelledby="questions-title"><div><span class="eyebrow">Before you choose</span><h2 id="questions-title">Know what you are starting with.</h2><p>Use the stack, application boundary, and source terms to evaluate the fit for your project.</p></div><div class="stack-list">{questions.map((item, index) => <article><span>0{index + 1}</span><h3>{item.question}</h3><p>{item.answer}</p></article>)}</div></section>
      <section class="related-section"><span class="eyebrow">Continue evaluating</span><h2>Find the right starting point.</h2><div class="link-grid"><a class="link-card" href={COMPANY_CONTACT_URL} data-cta-target="contact"><span>CONTACT / 01</span><h3>Ask about Next</h3><p>Confirm source access, delivery, license rights, updates, and support before committing.</p></a><a class="link-card" href="/compare/shipfast-vs-amsonia-next/"><span>COMPARE / 02</span><h3>ShipFast or Next?</h3><p>Compare database choices, billing scope, and how source access works.</p></a><a class="link-card" href="/compare/platform-vs-next/"><span>ARCHITECTURE / 03</span><h3>Compare with Platform</h3><p>Evaluate the separate Go service and multi-tenant operating model.</p></a><a class="link-card" href="/open-source/"><span>ENGINEERING / 04</span><h3>Explore our Go source</h3><p>Inspect our independently licensed authorization work and runnable examples on GitHub.</p></a></div></section>
    </div>
  </main>
</BaseLayout>
