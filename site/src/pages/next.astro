---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { COMPANY_CONTACT_URL, absoluteUrl, breadcrumbSchema, softwareProductSchema } from '../lib/site';

const description = 'A private Next.js SaaS starter with authentication, Stripe billing, PostgreSQL, Drizzle, and admin in one TypeScript application. Explore Amsonia Next by Willuny Labs.';
const schema = softwareProductSchema({ name: 'Amsonia Next', path: '/next', description, license: absoluteUrl('/license') });
---

<BaseLayout title="Amsonia Next — Next.js SaaS Starter" description={description} canonicalPath="/next" schemas={[schema, breadcrumbSchema([{ name: 'Amsonia', href: '/' }, { name: 'Next', href: '/next' }])]}>
  <main id="main-content">
    <PageIntro eyebrow="Amsonia Next / Private source" index="NEXT / 01" title="A focused Next.js SaaS starter you can own." summary="Build your SaaS with authentication, Stripe billing, PostgreSQL, and admin in one Next.js 16 application. Amsonia Next is privately maintained, with a focused single-tenant scope and full-stack TypeScript." />
    <div class="content-shell"><div class="hero-actions"><a class="button primary" href={COMPANY_CONTACT_URL} data-cta-target="contact">Ask about Amsonia Next ↗</a><a class="button secondary" href="#capabilities">Explore capabilities ↓</a></div></div>
    <div class="content-shell">
      <section class="section compact-section"><div class="metric-grid"><div><span>Framework</span><strong>Next.js 16</strong><p>App Router and full-stack TypeScript.</p></div><div><span>Data</span><strong>Drizzle</strong><p>PostgreSQL with explicit migrations.</p></div><div><span>Identity</span><strong>Auth.js</strong><p>Credentials, magic links, Google, and GitHub.</p></div><div><span>Availability</span><strong>Private source</strong><p>Contact Willuny Labs for availability and terms.</p></div></div></section>
      <section class="section split-section" id="capabilities"><div><span class="eyebrow">Useful on day one</span><h2>More than a landing-page template.</h2><p>The repository includes the product loops that usually sit behind the homepage.</p></div><div class="stack-list"><article><span>01</span><h3>Account lifecycle</h3><p>Registration, login, recovery, verification, session management, export, and deletion paths.</p></article><article><span>02</span><h3>Stripe billing</h3><p>Stripe checkout, subscriptions, customer portal integration, webhooks, and payment ledger flows.</p></article><article><span>03</span><h3>Administration</h3><p>An admin entry, privileged audit stream, subscription operations, and role-aware routing.</p></article><article><span>04</span><h3>Product surface</h3><p>Localized marketing routes, an MDX blog, metadata, sitemap, robots, and Open Graph foundations.</p></article></div></section>
      <section class="publication-note"><span class="eyebrow">Who it fits</span><h2>One application for a focused product.</h2><p>Amsonia Next suits founders and small teams who want account, payment, and admin flows together in one TypeScript codebase. The current application is single-tenant. If your product already requires customer organizations, workspace isolation, and a separate Go service, compare Amsonia Platform.</p><div class="hero-actions"><a class="button primary" href={COMPANY_CONTACT_URL} data-cta-target="contact">Ask about Next ↗</a><a class="button secondary" href="/compare/platform-vs-next/">Compare with Platform →</a></div></section>
      <section class="related-section"><span class="eyebrow">Product evaluation</span><h2>Inspect before adopting.</h2><div class="link-grid"><a class="link-card" href={COMPANY_CONTACT_URL}><span>CONTACT / 01</span><h3>Ask about Next</h3><p>Discuss product availability, implementation scope, support, and licensing with Willuny Labs.</p></a><a class="link-card" href="/license/"><span>RIGHTS / 02</span><h3>Source and license boundary</h3><p>Review each product&rsquo;s distribution status before evaluating adoption.</p></a><a class="link-card" href="/compare/platform-vs-next/"><span>FIT / 03</span><h3>Choose the right fit</h3><p>Compare stack, tenancy, licensing, and operating complexity.</p></a><a class="link-card" href="/about/"><span>FAMILY / 04</span><h3>Why Amsonia</h3><p>Understand the product family and its relationship to Willuny Labs.</p></a></div></section>
    </div>
  </main>
</BaseLayout>
