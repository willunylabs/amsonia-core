---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import WebsiteArtwork from '../components/WebsiteArtwork.astro';
import FeatureArtwork from '../components/FeatureArtwork.astro';
import { COMPANY_CONTACT_URL, NEXT_DEMO_URL, absoluteUrl, breadcrumbSchema, softwareProductSchema } from '../lib/site';

const description = 'Build on a Next.js SaaS starter with authentication, Stripe billing, PostgreSQL, Drizzle, and admin. Contact Willuny Labs about private source access.';
const schema = softwareProductSchema({ name: 'Amsonia Next', path: '/next', description, license: absoluteUrl('/license') });
const questions = [
  { question: 'What does this Next.js SaaS starter include?', answer: 'A full-stack TypeScript application with account management, Stripe checkout and subscriptions, PostgreSQL through Drizzle, administration, and marketing and content pages. Start with these shared flows and add your product logic.' },
  { question: 'Do I need a separate Go backend?', answer: 'Next keeps application routes, server-side logic, and UI in one Next.js codebase. You still configure PostgreSQL and the external services your application uses.' },
  { question: 'Is Amsonia Next open source?', answer: 'Next is a privately maintained commercial product. Contact Willuny Labs to confirm source access, delivery, licensing, updates, and support. The Apache-2.0 Go repository has its own scope and does not include the Next source.' },
  { question: 'Does Next include customer organizations and tenant isolation?', answer: 'The current Next product is single-tenant. Review the application architecture against any customer-organization or workspace-isolation requirements before choosing it.' }
];
---

<BaseLayout title="Amsonia Next — Next.js SaaS Starter" description={description} canonicalPath="/next" schemas={[schema, breadcrumbSchema([{ name: 'Amsonia', href: '/' }, { name: 'Next', href: '/next' }])]}>
  <main id="main-content">
    <PageIntro eyebrow="Next.js SaaS starter / Private source" index="NEXT / 01" title="Your SaaS, in one Next.js codebase." summary="Start with authentication, Stripe billing, PostgreSQL, and admin in one full-stack TypeScript application. Adapt the source to your product and deploy it in your own environment.">
      <WebsiteArtwork slot="artwork" variant="source" />
      <div slot="actions"><div class="hero-actions"><a class="button primary" href={COMPANY_CONTACT_URL} data-cta-target="contact">Ask about source access ↗</a><a class="button secondary" href={NEXT_DEMO_URL} data-cta-target="demo">Explore the demo ↗</a></div><p class="demo-preview-note">Public preview. Registration, email and payments are disabled.</p></div>
    </PageIntro>
    <div class="content-shell">
      <section class="section compact-section"><div class="metric-grid"><div><FeatureArtwork name="source" /><span>Framework</span><strong>Next.js 16</strong><p>App Router and full-stack TypeScript.</p></div><div><FeatureArtwork name="database" /><span>Data</span><strong>Drizzle</strong><p>PostgreSQL with explicit migrations.</p></div><div><FeatureArtwork name="identity" /><span>Identity</span><strong>Better Auth</strong><p>Credentials, magic links, Google, and GitHub.</p></div><div><FeatureArtwork name="docs" /><span>Availability</span><strong>Private source</strong><p>Contact Willuny Labs to confirm availability, license rights, delivery, and support.</p></div></div></section>
      <section class="section split-section" id="capabilities"><div><span class="eyebrow">Included features</span><h2>More than a landing-page template.</h2><p>Start with account management, payments, and admin tools, then add your product features.</p></div><div class="stack-list"><article><FeatureArtwork name="identity" class="stack-artwork" /><h3>Account management</h3><p>Registration, login, password recovery, email verification, sessions, data export, and account deletion.</p></article><article><FeatureArtwork name="billing" class="stack-artwork" /><h3>Stripe billing</h3><p>Checkout, subscriptions, a customer billing portal, webhooks, and payment records.</p></article><article><FeatureArtwork name="operations" class="stack-artwork" /><h3>Administration</h3><p>Admin pages, subscription management, audit logs, and role-based access.</p></article><article><FeatureArtwork name="docs" class="stack-artwork" /><h3>Marketing and content</h3><p>Localized pages, an MDX blog, metadata, sitemap, robots.txt, and Open Graph images.</p></article></div></section>
      <section class="publication-note"><span class="eyebrow">Who it fits</span><h2>One application for a focused product.</h2><p>Amsonia Next suits founders and small teams who want account, payment, and admin flows together in one TypeScript codebase. The current application is single-tenant. Review the architecture against your product requirements before choosing source access.</p><div class="hero-actions"><a class="button primary" href={COMPANY_CONTACT_URL} data-cta-target="contact">Ask about Next ↗</a><a class="button secondary" href="/compare/shipfast-vs-amsonia-next/">Compare with ShipFast →</a></div></section>
      <section class="section split-section" aria-labelledby="questions-title"><div><span class="eyebrow">Before you choose</span><h2 id="questions-title">Know what you are starting with.</h2><p>Use the stack, application boundary, and source terms to evaluate the fit for your project.</p></div><div class="stack-list">{questions.map((item, index) => <article><span>0{index + 1}</span><h3>{item.question}</h3><p>{item.answer}</p></article>)}</div></section>
      <section class="related-section"><span class="eyebrow">Learn more</span><h2>Find the right starting point.</h2><div class="link-grid"><a class="link-card" href={COMPANY_CONTACT_URL}><span>CONTACT / 01</span><h3>Ask about Next</h3><p>Discuss availability, included features, support, and licensing with Willuny Labs.</p></a><a class="link-card" href="/license/"><span>RIGHTS / 02</span><h3>Source access and licensing</h3><p>Check source availability and how each product can be used.</p></a><a class="link-card" href="/compare/shipfast-vs-amsonia-next/"><span>COMPARE / 03</span><h3>ShipFast or Next?</h3><p>Compare database choices, billing scope, and source access.</p></a><a class="link-card" href="/open-source/"><span>ENGINEERING / 04</span><h3>Explore our Go source</h3><p>Inspect our independently licensed administration scaffold and runnable examples on GitHub.</p></a></div></section>
    </div>
  </main>
</BaseLayout>
