---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { COMPANY_CONTACT_URL, absoluteUrl, breadcrumbSchema, softwareProductSchema } from '../lib/site';

const description = 'A private Next.js SaaS starter with authentication, Stripe billing, PostgreSQL, Drizzle, and admin in one TypeScript application. Explore Amsonia Next by Willuny Labs.';
const schema = softwareProductSchema({ name: 'Amsonia Next', path: '/next', description, license: absoluteUrl('/license') });
---

<BaseLayout title="Amsonia Next — Next.js SaaS Starter" description={description} canonicalPath="/next" schemas={[schema, breadcrumbSchema([{ name: 'Amsonia', href: '/' }, { name: 'Next', href: '/next' }])]}>
  <main id="main-content">
    <PageIntro eyebrow="Amsonia Next / Private source" index="NEXT / 01" title="Build your SaaS with one Next.js codebase." summary="Start with authentication, Stripe billing, PostgreSQL, and admin in one Next.js 16 application. Customize the full-stack TypeScript codebase for your product." />
    <div class="content-shell"><div class="hero-actions"><a class="button primary" href={COMPANY_CONTACT_URL} data-cta-target="contact">Ask about Amsonia Next ↗</a><a class="button secondary" href="#capabilities">Explore capabilities ↓</a></div></div>
    <div class="content-shell">
      <section class="section compact-section"><div class="metric-grid"><div><span>Framework</span><strong>Next.js 16</strong><p>App Router and full-stack TypeScript.</p></div><div><span>Data</span><strong>Drizzle</strong><p>PostgreSQL with explicit migrations.</p></div><div><span>Identity</span><strong>Auth.js</strong><p>Credentials, magic links, Google, and GitHub.</p></div><div><span>Availability</span><strong>Private source</strong><p>Contact Willuny Labs for availability and terms.</p></div></div></section>
      <section class="section split-section" id="capabilities"><div><span class="eyebrow">Included features</span><h2>More than a landing-page template.</h2><p>Start with account management, payments, and admin tools, then add your product features.</p></div><div class="stack-list"><article><span>01</span><h3>Account management</h3><p>Registration, login, password recovery, email verification, sessions, data export, and account deletion.</p></article><article><span>02</span><h3>Stripe billing</h3><p>Checkout, subscriptions, a customer billing portal, webhooks, and payment records.</p></article><article><span>03</span><h3>Administration</h3><p>Admin pages, subscription management, audit logs, and role-based access.</p></article><article><span>04</span><h3>Marketing and content</h3><p>Localized pages, an MDX blog, metadata, sitemap, robots.txt, and Open Graph images.</p></article></div></section>
      <section class="publication-note"><span class="eyebrow">Who it fits</span><h2>One application for a focused product.</h2><p>Amsonia Next suits founders and small teams who want account, payment, and admin flows together in one TypeScript codebase. The current application is single-tenant. If your product already requires customer organizations, workspace isolation, and a separate Go service, compare Amsonia Platform.</p><div class="hero-actions"><a class="button primary" href={COMPANY_CONTACT_URL} data-cta-target="contact">Ask about Next ↗</a><a class="button secondary" href="/compare/platform-vs-next/">Compare with Platform →</a></div></section>
      <section class="related-section"><span class="eyebrow">Learn more</span><h2>Find the right starting point.</h2><div class="link-grid"><a class="link-card" href={COMPANY_CONTACT_URL}><span>CONTACT / 01</span><h3>Ask about Next</h3><p>Discuss availability, included features, support, and licensing with Willuny Labs.</p></a><a class="link-card" href="/license/"><span>RIGHTS / 02</span><h3>Source access and licensing</h3><p>Check source availability and how each product can be used.</p></a><a class="link-card" href="/compare/platform-vs-next/"><span>FIT / 03</span><h3>Compare with Platform</h3><p>Compare frameworks, tenancy, and deployment needs.</p></a><a class="link-card" href="/about/"><span>FAMILY / 04</span><h3>About Amsonia</h3><p>Learn about the products and the company behind them.</p></a></div></section>
    </div>
  </main>
</BaseLayout>
