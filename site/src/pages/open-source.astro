---
import PageIntro from '../components/PageIntro.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbSchema, GITHUB_URL, GITHUB_ORGANIZATION_URL } from '../lib/site';

const description = 'Find public engineering repositories maintained by Willuny Labs and understand the source-availability boundary of the Amsonia product family.';
---

<BaseLayout title="Open-source Engineering" description={description} canonicalPath="/open-source" schemas={[breadcrumbSchema([{ name: 'Amsonia', href: '/' }, { name: 'Open source', href: '/open-source' }])]}>
  <main id="main-content">
    <PageIntro eyebrow="Public engineering" index="OSS / 00" title="Inspect our public engineering work." summary="Willuny Labs maintains public engineering repositories alongside its privately maintained products. Each public repository documents its own scope, setup, and license." />
    <div class="content-shell">
      <section class="section">
        <div class="core-grid">
          <article><span class="specimen-number">GITHUB / PUBLIC SOURCE</span><h3>Engineering<br />on GitHub</h3><p>Review the public source, documentation, tests, and license directly in the repository before using it in your application.</p><div class="hero-actions"><a class="button primary" href={GITHUB_URL} data-cta-target="github">Inspect public source ↗</a><a class="button secondary" href={GITHUB_ORGANIZATION_URL} data-cta-target="github">Willuny Labs on GitHub ↗</a></div></article>
          <aside class="boundary-note"><div><span class="eyebrow">Product boundary</span><h3>Public source has an explicit scope.</h3><p>Amsonia Next is privately maintained and is not an open-source distribution. Platform source is delivered under its commercial package terms. A public engineering repository does not grant access to either product.</p></div><a class="button secondary" href="/license/">Review product terms →</a></aside>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
