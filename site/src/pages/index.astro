---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  absoluteUrl,
  amsoniaBrandReference,
  amsoniaProductReference,
  COMMERCIAL_URL,
  COMPANY_NAME,
  GITHUB_URL,
  publisherReference,
  SITE_ORIGIN
} from '../lib/site';

const description = 'Source-owned infrastructure for multi-tenant Go applications. Explore Amsonia Core, its documentation, security model, releases, and commercial product boundary.';
const schemas = [{
  '@context': 'https://schema.org',
  '@graph': [
    {
      ...publisherReference,
      legalName: COMPANY_NAME,
      logo: absoluteUrl('/amsonia-mark-v2.svg'),
    },
    {
      ...amsoniaBrandReference,
      logo: absoluteUrl('/amsonia-mark-v2.svg')
    },
    {
      ...amsoniaProductReference,
      description,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Self-hosted',
      brand: { '@id': `${SITE_ORIGIN}/#brand` },
      publisher: { '@id': publisherReference['@id'] },
      hasPart: { '@id': `${absoluteUrl('/core')}#source` }
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_ORIGIN}/#website`,
      name: 'Amsonia',
      url: `${SITE_ORIGIN}/`,
      description,
      inLanguage: 'en-US',
      publisher: { '@id': publisherReference['@id'] },
      about: { '@id': `${SITE_ORIGIN}/#product` }
    }
  ]
}];
---

<BaseLayout title="Amsonia" description={description} canonicalPath="/" schemas={schemas}>
  <main id="main-content">
    <section class="hero">
      <div class="shell hero-inner">
        <div class="hero-copy">
          <span class="eyebrow">Amsonia / Software product / Est. 2026</span>
          <h1>Amsonia</h1>
          <p class="hero-thesis">Source-owned infrastructure for multi-tenant Go applications.</p>
          <p class="hero-summary">
            Amsonia Core is the first public component: an Apache-2.0 authorization foundation built with Go, PostgreSQL RLS, and a React management console.
          </p>
          <div class="hero-actions">
            <a class="button primary" href={GITHUB_URL} data-cta-target="github">GitHub source <span aria-hidden="true">↗</span></a>
            <a class="button secondary" href="/core/docs/getting-started/" data-cta-target="docs">Documentation <span aria-hidden="true">→</span></a>
            <a class="button quiet" href="/core/security/">Security model <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <div class="hero-specimen" aria-label="Amsonia Core product summary">
          <div class="hero-product-header">
            <span><img src="/amsonia-mark-v2.svg" width="34" height="34" alt="" /> Open-source foundation</span>
            <strong>Released</strong>
          </div>
          <div class="hero-product-copy">
            <span class="eyebrow">Core / 01</span>
            <h2>Amsonia Core</h2>
            <p>Tenant-safe authorization for Go and PostgreSQL teams.</p>
          </div>
          <div class="hero-product-features">
            <div><span>01</span><strong>Go-first</strong><small>Standalone API and CLI</small></div>
            <div><span>02</span><strong>Tenant-safe</strong><small>Signed context and RLS</small></div>
            <div><span>03</span><strong>Inspectable</strong><small>Versioned policy evidence</small></div>
            <div><span>04</span><strong>Source-owned</strong><small>Apache-2.0 foundation</small></div>
          </div>
          <a class="hero-product-link" href="/core/">Explore Amsonia Core <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="band">
      <div class="shell brand-contract">
        <div><span class="specimen-number">PRODUCT / 00</span></div>
        <div>
          <h2>One inspectable security boundary.</h2>
          <p>Core keeps tenant membership, delegated policy, administrator sessions, audit history, and PostgreSQL row isolation in source you can run and review.</p>
        </div>
        <div>
          <h3>Core leads today.</h3>
          <p>Only released products appear here. New components enter the system when their source, documentation, and support boundary are ready.</p>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="shell">
        <div class="section-heading">
          <span class="eyebrow">Open source / First component</span>
          <div class="section-heading-copy">
            <h2>Own the authorization boundary.</h2>
            <p>Amsonia Core packages the boundary that is expensive to retrofit later: tenant membership, delegated RBAC, signed PostgreSQL row-level security, authenticated administrator sessions, and an auditable policy history.</p>
          </div>
        </div>

        <div class="core-grid">
          <article>
            <span class="specimen-number">CORE / APACHE-2.0</span>
            <h3>Amsonia<br />Core</h3>
            <p>Open-source foundation inside Amsonia, implemented in Go with PostgreSQL and a React management console.</p>
            <ul class="capability-list">
              <li>Tenant-first delegated authorization</li>
              <li>Signed context and forced PostgreSQL RLS</li>
              <li>Versioned roles and permission catalogs</li>
              <li>Argon2id authentication and rotating sessions</li>
              <li>Append-only policy audit events</li>
              <li>Versioned HTTP and OpenAPI contract</li>
            </ul>
            <div class="hero-actions">
              <a class="button primary" href="/core/">Explore Core <span aria-hidden="true">→</span></a>
              <a class="button secondary" href="/core/docs/getting-started/">Run locally <span aria-hidden="true">→</span></a>
            </div>
          </article>
          <aside class="boundary-note">
            <div>
              <span class="eyebrow">Scope boundary</span>
              <h3>Precise by design.</h3>
              <p>Core covers identity, sessions, tenants, memberships, roles, permissions, authorization decisions, and policy audit.</p>
              <p>Billing, commerce, AI, education, messaging, and white-label operations belong to Amsonia Platform—not this repository.</p>
            </div>
            <code>core.status = "open-source"<br />core.license = "Apache-2.0"<br />publisher = "Willuny Labs"</code>
          </aside>
        </div>
      </div>
    </section>

    <section class="section band">
      <div class="shell">
        <div class="section-heading">
          <span class="eyebrow">Evaluate / Follow the evidence</span>
          <div class="section-heading-copy">
            <h2>Read the boundary before the promise.</h2>
            <p>Every technical claim on this site is tied to public code, a versioned contract, a negative test, or a maintained document in Amsonia Core.</p>
          </div>
        </div>
        <div class="link-grid">
          <a class="link-card" href="/core/docs/getting-started/">
            <span>DOC / 01</span><h3>Start locally</h3><p>Run the complete least-privileged PostgreSQL, API, and Console stack with one command.</p>
          </a>
          <a class="link-card" href="/core/security/">
            <span>SEC / 02</span><h3>Security model</h3><p>Understand signed tenant context, forced RLS, negative tests, and operational assumptions.</p>
          </a>
          <a class="link-card" href="/core/api/">
            <span>API / 03</span><h3>HTTP contract</h3><p>Inspect the versioned OpenAPI contract for authentication, tenants, roles, audit, and decisions.</p>
          </a>
          <a class="link-card" href="/releases/">
            <span>REL / 04</span><h3>Release history</h3><p>Follow the public tags and release notes instead of relying on an unversioned feature list.</p>
          </a>
        </div>
      </div>
    </section>

    <section class="commercial-panel">
      <div>
        <span class="eyebrow">Commercial distribution</span>
        <h2>Build beyond Core.</h2>
      </div>
      <div>
        <p>Amsonia Platform is the commercial Go + Next.js SaaS starter kit, composed of Amsonia Server and Amsonia Console. Its demo, pricing, licensing, purchase, and support live with Willuny Labs.</p>
        <a class="button" href={COMMERCIAL_URL} data-cta-target="commercial">Explore Amsonia Platform <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>
</BaseLayout>
