---
import BaseLayout from '../layouts/BaseLayout.astro';
import WebsiteArtwork from '../components/WebsiteArtwork.astro';
import FeatureArtwork from '../components/FeatureArtwork.astro';
import {
  absoluteUrl,
  amsoniaBrandReference,
  amsoniaProductReference,
  COMPANY_CONTACT_URL,
  GITHUB_URL,
  publisherReference,
  SITE_ORIGIN
} from '../lib/site';

const description = 'Explore Amsonia Next, the Next.js SaaS starter with authentication, Stripe billing, PostgreSQL, and admin in one full-stack TypeScript application.';
const nextId = `${absoluteUrl('/next')}#software`;
const schemas = [{
  '@context': 'https://schema.org',
  '@graph': [
    publisherReference,
    { ...amsoniaBrandReference, logo: absoluteUrl('/amsonia-mark-v2.svg') },
    {
      ...amsoniaProductReference,
      description,
      about: { '@id': `${SITE_ORIGIN}/#brand` },
      publisher: { '@id': publisherReference['@id'] },
      isPartOf: { '@id': `${SITE_ORIGIN}/#website` },
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Amsonia Next', url: absoluteUrl('/next'), item: { '@id': nextId } },
        ]
      }
    },
    {
      '@type': 'WebSite', '@id': `${SITE_ORIGIN}/#website`, name: 'Amsonia',
      url: `${SITE_ORIGIN}/`, description, inLanguage: 'en-US',
      publisher: { '@id': publisherReference['@id'] },
      about: { '@id': `${SITE_ORIGIN}/#product-family` }
    }
  ]
}];
---

<BaseLayout title="Amsonia" description={description} canonicalPath="/" schemas={schemas}>
  <main id="main-content">
    <section class="hero family-hero">
      <div class="shell hero-inner">
        <div class="hero-copy">
          <span class="eyebrow">SaaS starters by Willuny Labs</span>
          <h1>A foundation for your next SaaS.</h1>
          <p class="hero-thesis">Start with Amsonia Next.</p>
          <p class="hero-summary">Build with authentication, Stripe billing, PostgreSQL, and admin in one full-stack TypeScript application.</p>
          <div class="hero-actions">
            <a class="button primary" href="/next/">Explore Amsonia Next <span aria-hidden="true">→</span></a>
            <a class="button secondary" href={COMPANY_CONTACT_URL} data-cta-target="contact">Ask about source access <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <figure class="family-artwork">
          <WebsiteArtwork variant="source" />
          <figcaption>
            <div class="artwork-product-links single-product">
              <a href="/next/"><span class="eyebrow">01 / Private source</span><strong>Amsonia Next</strong><small>Authentication · Stripe · PostgreSQL · Admin</small><span aria-hidden="true">→</span></a>
            </div>
            <a class="artwork-source-link" href={GITHUB_URL} data-cta-target="github">View engineering work on GitHub ↗</a>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="band"><div class="shell brand-contract">
      <div><span class="specimen-number">FAMILY / 00</span></div>
      <div><h2>Build in one Next.js application.</h2><p>Amsonia Next brings account management, payments, data, and administration together. Review its included features and source access before adopting it.</p></div>
      <div><h3>Built by Willuny Labs.</h3><p>Amsonia Next is privately maintained. Talk to us about source access, licensing, and support before adopting it.</p></div>
    </div></section>

    <section class="section"><div class="shell">
      <div class="section-heading"><span class="eyebrow">Products / Start with Next</span><div class="section-heading-copy"><h2>A focused foundation for your SaaS.</h2><p>Start with account management, Stripe billing, PostgreSQL, and admin, then add the features your product needs.</p></div></div>
      <div class="product-grid single-product">
        <article class="product-card product-card-featured"><span class="specimen-number">NEXT / PRIVATE SOURCE</span><div class="artwork-product-heading"><h2>Amsonia Next</h2><FeatureArtwork name="source" /></div><p class="product-lede">A Next.js 16 SaaS starter for founders who want one full-stack TypeScript codebase.</p><ul class="capability-list"><li>Authentication and account lifecycle</li><li>Stripe checkout, subscriptions, and webhooks</li><li>PostgreSQL with Drizzle migrations</li><li>Admin, audit, and localized product routes</li></ul><div class="hero-actions"><a class="button primary" href="/next/">Explore Amsonia Next →</a><a class="button secondary" href={COMPANY_CONTACT_URL} data-cta-target="contact">Contact about Next ↗</a></div></article>
      </div>
    </div></section>

    <section class="section band"><div class="shell">
      <div class="section-heading"><span class="eyebrow">Explore / Find your fit</span><div class="section-heading-copy"><h2>See what your product needs.</h2><p>Explore the Next.js starter, review source availability, and discuss your project with Willuny Labs.</p></div></div>
      <div class="link-grid">
        <a class="link-card" href="/docs/"><span>DOCS / 01</span><h3>Source and documentation</h3><p>Find the product overview, source access, and documentation contact path.</p></a>
        <a class="link-card" href="/next/"><span>NEXT / 02</span><h3>Inside Amsonia Next</h3><p>Review authentication, Stripe billing, admin, and the current application scope.</p></a>
        <a class="link-card" href="/pricing/"><span>ACCESS / 03</span><h3>Source availability</h3><p>Discuss source availability, licensing, and support for Amsonia Next.</p></a>
        <a class="link-card" href="/open-source/"><span>OSS / 04</span><h3>Inspect the source</h3><p>Review the public engineering repositories maintained by Willuny Labs.</p></a>
      </div>
    </div></section>

    <section class="commercial-panel"><div><span class="eyebrow">Amsonia Next</span><h2>Build your next SaaS with Next.</h2></div><div><p>Tell Willuny Labs what you are building. Confirm source availability, license rights, and support for Amsonia Next.</p><a class="button" href={COMPANY_CONTACT_URL} data-cta-target="contact">Ask about Amsonia Next <span aria-hidden="true">↗</span></a></div></section>
  </main>
</BaseLayout>
