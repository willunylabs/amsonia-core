---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  absoluteUrl,
  amsoniaBrandReference,
  amsoniaProductReference,
  AMSONIA_NEXT_GITHUB_URL,
  COMMERCIAL_URL,
  COMPANY_NAME,
  GITHUB_URL,
  publisherReference,
  SITE_ORIGIN
} from '../lib/site';

const description = 'Amsonia is a family of source-owned SaaS foundations: a commercial Go + Next.js platform and an open-source Next.js starter, published by Willuny Labs.';
const platformId = `${absoluteUrl('/platform')}#software`;
const nextId = `${absoluteUrl('/next')}#software`;
const schemas = [{
  '@context': 'https://schema.org',
  '@graph': [
    { ...publisherReference, legalName: COMPANY_NAME, logo: absoluteUrl('/amsonia-mark-v2.svg') },
    { ...amsoniaBrandReference, logo: absoluteUrl('/amsonia-mark-v2.svg') },
    {
      ...amsoniaProductReference,
      description,
      brand: { '@id': `${SITE_ORIGIN}/#brand` },
      manufacturer: { '@id': publisherReference['@id'] },
      hasVariant: [{ '@id': platformId }, { '@id': nextId }]
    },
    {
      '@type': 'SoftwareApplication', '@id': platformId, name: 'Amsonia Platform',
      url: absoluteUrl('/platform'), applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Self-hosted', isPartOf: { '@id': `${SITE_ORIGIN}/#product-family` }
    },
    {
      '@type': 'SoftwareApplication', '@id': nextId, name: 'Amsonia Next',
      url: absoluteUrl('/next'), applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Self-hosted', license: 'https://opensource.org/license/mit',
      isAccessibleForFree: true, isPartOf: { '@id': `${SITE_ORIGIN}/#product-family` }
    },
    {
      '@type': 'WebSite', '@id': `${SITE_ORIGIN}/#website`, name: 'Amsonia',
      url: `${SITE_ORIGIN}/`, description, inLanguage: 'en-US',
      publisher: { '@id': publisherReference['@id'] },
      about: { '@id': `${SITE_ORIGIN}/#product-family` }
    }
  ]
}];
---

<BaseLayout title="Amsonia" description={description} canonicalPath="/" schemas={schemas}>
  <main id="main-content">
    <section class="hero family-hero">
      <div class="shell hero-inner">
        <div class="hero-copy">
          <span class="eyebrow">Amsonia / Product family / By Willuny Labs</span>
          <h1>Build the product. Own the foundation.</h1>
          <p class="hero-thesis">Source-owned SaaS foundations for two ways of shipping.</p>
          <p class="hero-summary">Choose a commercial Go + Next.js platform for multi-tenant B2B software, or start with a focused open-source Next.js kit. Both keep your application, data, and deployment decisions in your hands.</p>
          <div class="hero-actions">
            <a class="button primary" href="/products/">Choose your foundation <span aria-hidden="true">→</span></a>
            <a class="button secondary" href="/next/">Explore open-source Next <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <div class="hero-specimen family-specimen" aria-label="Amsonia product family summary">
          <div class="hero-product-header"><span><img src="/amsonia-mark-v2.svg" width="34" height="34" alt="" /> Two product paths</span><strong>Source owned</strong></div>
          <a class="family-specimen-row" href="/platform/"><span class="eyebrow">01 / Commercial</span><strong>Amsonia Platform</strong><small>Go + Next.js · Multi-tenant B2B</small><span aria-hidden="true">→</span></a>
          <a class="family-specimen-row" href="/next/"><span class="eyebrow">02 / MIT</span><strong>Amsonia Next</strong><small>Next.js 16 · Single-tenant starter</small><span aria-hidden="true">→</span></a>
          <div class="family-specimen-note"><span>Additional open source</span><a href={GITHUB_URL} data-cta-target="github">View engineering work on GitHub ↗</a></div>
        </div>
      </div>
    </section>

    <section class="band"><div class="shell brand-contract">
      <div><span class="specimen-number">FAMILY / 00</span></div>
      <div><h2>One product family, not one forced stack.</h2><p>Each product has a distinct buyer, license, and architecture. Shared principles connect them; search intent and technical scope stay explicit.</p></div>
      <div><h3>Published by Willuny Labs.</h3><p>This site owns product evaluation. Willuny Labs remains the company, seller, and commercial support boundary.</p></div>
    </div></section>

    <section class="section"><div class="shell">
      <div class="section-heading"><span class="eyebrow">Products / Pick the constraint</span><div class="section-heading-copy"><h2>Start with the architecture you actually need.</h2><p>Platform is for a team already committed to Go and multi-tenant operations. Next is for a product that benefits from one full-stack Next.js codebase and a smaller operating surface.</p></div></div>
      <div class="product-grid">
        <article class="product-card product-card-featured"><span class="specimen-number">PLATFORM / COMMERCIAL SOURCE</span><h2>Amsonia Platform</h2><p class="product-lede">A Go + Next.js SaaS starter kit for multi-tenant B2B products.</p><ul class="capability-list"><li>Go API and Next.js product surface</li><li>Tenant and workspace boundaries</li><li>Roles, permissions, and operations</li><li>Stripe-oriented commerce and billing</li></ul><div class="hero-actions"><a class="button primary" href="/platform/">Evaluate Platform →</a><a class="button secondary" href="/go-saas-boilerplate/">Go SaaS guide →</a></div></article>
        <article class="product-card"><span class="specimen-number">NEXT / OPEN SOURCE / MIT</span><h2>Amsonia Next</h2><p class="product-lede">A single-tenant Next.js 16 SaaS starter for founders who want a focused full-stack base.</p><ul class="capability-list"><li>Auth.js and PostgreSQL with Drizzle</li><li>Stripe and Lemon Squeezy adapters</li><li>Admin, account, audit, and billing flows</li><li>English and Chinese route foundations</li></ul><div class="hero-actions"><a class="button primary" href="/next/">Explore Amsonia Next →</a><a class="button secondary" href={AMSONIA_NEXT_GITHUB_URL} data-cta-target="github">GitHub source ↗</a></div></article>
      </div>
    </div></section>

    <section class="section band"><div class="shell">
      <div class="section-heading"><span class="eyebrow">Decision / No vague tiers</span><div class="section-heading-copy"><h2>Choose by system boundary.</h2><p>The deciding question is not free versus paid. It is whether your product needs a Go service and multi-tenant operating model now.</p></div></div>
      <div class="link-grid">
        <a class="link-card" href="/compare/platform-vs-next/"><span>COMPARE / 01</span><h3>Platform vs Next</h3><p>Compare runtime, tenancy, license, billing providers, and the intended team.</p></a>
        <a class="link-card" href="/architecture/"><span>ARCH / 02</span><h3>Platform architecture</h3><p>See how the Go API, Next.js surfaces, PostgreSQL, and deployment boundary fit together.</p></a>
        <a class="link-card" href="/features/multi-tenancy/"><span>TENANCY / 03</span><h3>Multi-tenant by design</h3><p>Follow tenant context from identity through authorization, jobs, cache keys, and data access.</p></a>
        <a class="link-card" href="/open-source/"><span>OSS / 04</span><h3>Inspect the source</h3><p>Start with Amsonia Next, review its license, and follow the implementation before adopting it.</p></a>
      </div>
    </div></section>

    <section class="commercial-panel"><div><span class="eyebrow">Commercial path</span><h2>Need multi-tenant Go?</h2></div><div><p>Evaluate Amsonia Platform here, then continue to the transaction-only source package catalog operated by Willuny Labs.</p><a class="button" href={COMMERCIAL_URL} data-cta-target="commercial">View Platform source packages <span aria-hidden="true">↗</span></a></div></section>
  </main>
</BaseLayout>
