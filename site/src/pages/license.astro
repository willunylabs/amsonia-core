---
import TopicPage from '../components/TopicPage.astro';
import { breadcrumbSchema, COMMERCIAL_URL } from '../lib/site';
const description = 'Review source access and licensing for Amsonia Next, the privately maintained Next.js SaaS starter published by Willuny Labs.';
---
<TopicPage eyebrow="License boundary" index="LICENSE / 01" title="Amsonia Next source access." summary="Amsonia Next is privately maintained. Confirm source availability and applicable terms with Willuny Labs before adopting it." description={description} canonicalPath="/license" schemas={[breadcrumbSchema([{ name: 'Amsonia', href: '/' }, { name: 'License', href: '/license' }])]}
  sections={[
    { id: 'next', title: 'Amsonia Next — private source', paragraphs: ['Amsonia Next is privately maintained and is not offered as an open-source distribution.', 'Contact Willuny Labs to confirm availability and the applicable terms before adopting it. This page does not grant access or distribution rights.'] },
    { id: 'operations', title: 'Licenses do not operate the product', paragraphs: ['Open-source and commercial-source rights do not include cloud hosting, database service, email delivery, payment-provider fees, tax handling, maintenance, security review, or compliance work unless an offer explicitly includes them.', 'Buyers remain responsible for the dependencies, infrastructure, data, and modifications in their deployed product.'] }
  ]}
  relatedLinks={[{ href: '/next/', label: 'Amsonia Next', description: 'Review the private Next.js foundation.' }, { href: '/open-source/', label: 'Open-source boundary', description: 'Find public engineering repositories and their own license terms.' }, { href: COMMERCIAL_URL, label: 'Current packages', description: 'Review transaction-specific commercial terms.' }]}
/>
