---
import TopicPage from '../components/TopicPage.astro';
import { breadcrumbSchema, COMMERCIAL_URL } from '../lib/site';
const description = 'Understand the license boundary between the privately maintained Amsonia Next foundation and commercial-source Amsonia Platform packages.';
---
<TopicPage eyebrow="License boundary" index="LICENSE / 01" title="Two products. Explicit rights." summary="Amsonia is a product family, not a shared license. Each product has its own distribution status and terms. Amsonia Next is privately maintained." description={description} canonicalPath="/license" schemas={[breadcrumbSchema([{ name: 'Amsonia', href: '/' }, { name: 'License', href: '/license' }])]}
  sections={[
    { id: 'next', title: 'Amsonia Next — private source', paragraphs: ['Amsonia Next is privately maintained and is not offered as an open-source distribution.', 'Contact Willuny Labs to confirm availability and the applicable terms before adopting it. This page does not grant access or distribution rights.'] },
    { id: 'platform', title: 'Amsonia Platform — commercial source', paragraphs: ['Platform source is delivered under the commercial terms attached to the purchased package. Those terms define permitted use, company or repository-user scope, updates, support, distribution restrictions, and other rights.', 'The transaction catalog and accepted agreement control. This overview is product guidance, not a substitute for the license text.'] },
    { id: 'operations', title: 'Licenses do not operate the product', paragraphs: ['Open-source and commercial-source rights do not include cloud hosting, database service, email delivery, payment-provider fees, tax handling, maintenance, security review, or compliance work unless an offer explicitly includes them.', 'Buyers remain responsible for the dependencies, infrastructure, data, and modifications in their deployed product.'] }
  ]}
  relatedLinks={[{ href: '/next/', label: 'Amsonia Next', description: 'Review the private Next.js foundation.' }, { href: '/open-source/', label: 'Open-source boundary', description: 'Find public engineering repositories and their own license terms.' }, { href: '/platform/', label: 'Amsonia Platform', description: 'Evaluate the commercial source product.' }, { href: COMMERCIAL_URL, label: 'Current packages', description: 'Review transaction-specific commercial terms.' }]}
/>
