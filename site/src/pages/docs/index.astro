---
import PageIntro from '../../components/PageIntro.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { breadcrumbSchema } from '../../lib/site';

const description = 'Documentation entry point for the Amsonia technical product family, with Amsonia Core setup, API, security, and license references.';
---

<BaseLayout title="Amsonia Documentation" description={description} canonicalPath="/docs" schemas={[breadcrumbSchema([{ name: 'Amsonia', href: '/' }, { name: 'Docs', href: '/docs' }])]}>
  <main id="main-content">
    <PageIntro eyebrow="Product family index" index="DOC / 00" title="Documentation" summary="One entry point for released Amsonia products. Today, the maintained public documentation set belongs to Amsonia Core." />
    <div class="content-shell">
      <section class="section">
        <div class="link-grid">
          <a class="link-card" href="/core/docs"><span>CORE / DOCS</span><h3>Core docs</h3><p>Setup requirements, security assumptions, API contract, and repository references.</p></a>
          <a class="link-card" href="/core/docs/getting-started"><span>CORE / START</span><h3>Getting started</h3><p>Bring up the database roles, migrations, administrator, API, and console.</p></a>
          <a class="link-card" href="/core/api"><span>CORE / API</span><h3>API contract</h3><p>Read the scope and inspect the versioned OpenAPI source.</p></a>
          <a class="link-card" href="/core/security"><span>CORE / SECURITY</span><h3>Security model</h3><p>Review tenant bindings, forced RLS, credentials, and operating boundaries.</p></a>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
