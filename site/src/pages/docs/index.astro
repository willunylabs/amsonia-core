---
import PageIntro from '../../components/PageIntro.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { COMPANY_CONTACT_URL, breadcrumbSchema } from '../../lib/site';

const description = 'Find the Amsonia Next product overview and contact Willuny Labs about private source access, documentation, deployment, and support.';
---

<BaseLayout title="Amsonia Documentation" description={description} canonicalPath="/docs" schemas={[breadcrumbSchema([{ name: 'Amsonia', href: '/' }, { name: 'Docs', href: '/docs' }])]}>
  <main id="main-content">
    <PageIntro eyebrow="Product documentation" index="DOC / 00" title="Documentation" summary="Review the Amsonia Next product overview and contact Willuny Labs about source access and documentation." />
    <div class="content-shell">
      <section class="section">
        <div class="link-grid">
          <a class="link-card" href="/next/"><span>NEXT / OVERVIEW</span><h3>Next product page</h3><p>Evaluate the single-tenant boundary, included flows, stack, and license.</p></a>
          <a class="link-card" href={COMPANY_CONTACT_URL}><span>NEXT / CONTACT</span><h3>Next availability</h3><p>Ask Willuny Labs about the private Next.js foundation, documentation, availability, and terms.</p></a>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
