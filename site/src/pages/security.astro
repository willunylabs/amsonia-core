---
import TopicPage from '../components/TopicPage.astro';
import { breadcrumbSchema, COMPANY_ORIGIN } from '../lib/site';
const description = 'Review Amsonia Platform security boundaries for authentication, server-side authorization, tenant isolation, payment webhooks, secrets, operations, and buyer responsibility.';
---
<TopicPage eyebrow="Platform security" index="SEC / 01" title="Security boundaries, without borrowed guarantees" summary="Amsonia provides implementation foundations for identity, authorization, tenant scope, and payment operations. Buyers configure, extend, review, and operate those controls for their product." description={description} canonicalPath="/security" schemas={[breadcrumbSchema([{ name: 'Amsonia', href: '/' }, { name: 'Platform', href: '/platform' }, { name: 'Security', href: '/security' }])]}
  sections={[
    { id: 'identity', title: 'Authenticate, then authorize', paragraphs: ['Protected actions require an authenticated identity and a server-side authorization decision. Session presence alone does not grant access, and interface visibility never substitutes for API enforcement.', 'Roles, permissions, membership, and administrative access remain separate concepts with explicit audit paths.'] },
    { id: 'isolation', title: 'Preserve tenant scope end to end', paragraphs: ['Trusted request context is checked against membership before protected data access. Repositories, transactions, background jobs, caches, exports, files, and integrations must preserve the same customer boundary.', 'Negative cross-tenant tests are maintained as permanent product gates rather than a one-time launch exercise.'] },
    { id: 'payments', title: 'Keep secrets and payment authority server-side', paragraphs: ['Provider keys do not enter browser code, committed fixtures, screenshots, or logs. Payment webhooks are signature-verified and processed idempotently before subscription or fulfillment state changes.', 'Buyer environments supply their own credentials, rotation, access controls, alerting, and incident response.'] },
    { id: 'claims', title: 'Know what is not claimed', paragraphs: ['These pages describe product design and implementation boundaries. They do not claim penetration testing, SOC 2, GDPR compliance, guaranteed isolation, or suitability for every regulated workload.', 'Security depends on buyer modifications, infrastructure, provider configuration, operations, and the data handled by the deployed product.'] }
  ]}
  relatedLinks={[{ href: '/features/multi-tenancy/', label: 'Multi-tenancy', description: 'Review the customer data boundary.' }, { href: '/features/rbac/', label: 'RBAC', description: 'Review protected-action enforcement.' }, { href: '/features/stripe-billing/', label: 'Billing security', description: 'Follow server-owned payment decisions.' }, { href: `${COMPANY_ORIGIN}/shop/contact`, label: 'Report a concern', description: 'Use the Willuny Labs contact path without sending secrets.' }]}
/>
