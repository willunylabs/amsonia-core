---
import PageIntro from '../../../components/PageIntro.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { breadcrumbSchema } from '../../../lib/site';

const description = 'Amsonia Core documentation for local setup, the versioned API, security model, Apache-2.0 license, and public source repository.';
---

<BaseLayout title="Amsonia Core Documentation" description={description} canonicalPath="/core/docs" schemas={[breadcrumbSchema([{ name: 'Amsonia', href: '/' }, { name: 'Core', href: '/core' }, { name: 'Docs', href: '/core/docs' }])]}>
  <main id="main-content">
    <PageIntro eyebrow="Core reference" index="CORE / DOC" title="Core docs" summary="Use the public contract, setup guide, and security model together. Core is useful only when its database and authorization boundaries remain explicit." />
    <div class="content-shell">
      <section class="section">
        <div class="link-grid docs-grid">
          <a class="link-card" href="/core/docs/getting-started"><span>01 / SETUP</span><h3>Getting started</h3><p>Least-privileged PostgreSQL roles, migrations, bootstrap, API, and Console.</p></a>
          <a class="link-card" href="/core/docs/business-data-rls"><span>02 / PROOF</span><h3>Business-data RLS</h3><p>Protect a host invoice table and verify negative cross-tenant behavior.</p></a>
          <a class="link-card" href="/core/api"><span>03 / CONTRACT</span><h3>API</h3><p>Authentication, tenants, memberships, roles, audit, and authorization checks.</p></a>
          <a class="link-card" href="/core/security"><span>04 / BOUNDARY</span><h3>Security</h3><p>Signed transaction context, forced RLS, session behavior, and operator duties.</p></a>
          <a class="link-card" href="/core/license"><span>05 / RIGHTS</span><h3>License</h3><p>Apache-2.0 applies to Core; the complete product is licensed separately.</p></a>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
