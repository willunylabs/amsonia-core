---
import PageIntro from '../../components/PageIntro.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { breadcrumbSchema, COMMERCIAL_URL, GITHUB_URL } from '../../lib/site';

const description = 'Amsonia Core is licensed under Apache-2.0. Review the open-source license boundary and the separate commercial distribution from Willuny Labs.';
---

<BaseLayout title="Amsonia Core License" description={description} canonicalPath="/core/license" schemas={[breadcrumbSchema([{ name: 'Amsonia', href: '/' }, { name: 'Core', href: '/core' }, { name: 'License', href: '/core/license' }])]}>
  <main id="main-content">
    <PageIntro eyebrow="Open-source rights" index="CORE / LIC" title="Apache-2.0" summary="Amsonia Core is open source under the Apache License 2.0. Amsonia Source Distribution and modules outside this repository are licensed separately." />
    <div class="content-shell">
      <div class="content-grid">
        <aside class="content-aside"><nav aria-label="License sections"><a href="#core">Core license</a><a href="#boundary">Boundary</a><a href="#commercial">Commercial</a></nav></aside>
        <article class="prose">
          <h2 id="core">The repository license is authoritative.</h2>
          <p>The Apache-2.0 license applies to the Amsonia Core repository. Read the included LICENSE file for the complete terms, notices, conditions, and limitations.</p>
          <h2 id="boundary">Open source does not imply every Amsonia module.</h2>
          <p>Core covers the authorization foundation published in the repository. Billing, commerce, AI, education, messaging, media, white-label operations, and other complete-product modules are outside the Core license unless separately published.</p>
          <h2 id="commercial">Commercial distribution lives at Willuny.</h2>
          <p>Willuny Labs publishes Amsonia Source Distribution, including its pricing, license scope, update policy, and purchase flow.</p>
          <div class="hero-actions"><a class="button primary" href={`${GITHUB_URL}/blob/main/LICENSE`} data-cta-target="github">Read LICENSE ↗</a><a class="button secondary" href={COMMERCIAL_URL} data-cta-target="commercial">Amsonia Source Distribution ↗</a></div>
        </article>
      </div>
    </div>
  </main>
</BaseLayout>
