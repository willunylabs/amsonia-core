---
import PageIntro from '../components/PageIntro.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbSchema, GITHUB_URL } from '../lib/site';

const description = 'Follow versioned Amsonia Core releases, beginning with v0.1.0, and review public tags and release notes in the source repository.';
---

<BaseLayout title="Amsonia Releases" description={description} canonicalPath="/releases" schemas={[breadcrumbSchema([{ name: 'Amsonia', href: '/' }, { name: 'Releases', href: '/releases' }])]}>
  <main id="main-content">
    <PageIntro eyebrow="Published versions" index="REL / 00" title="Releases" summary="Release pages follow public tags, not roadmap promises. Amsonia Core is the first released component in the product family." />
    <div class="content-shell">
      <section class="section">
        <article class="release-card">
          <div><strong>v0.1.0</strong><br /><time datetime="2026-08-04">2026-08-04</time></div>
          <div><span>AMSONIA CORE</span><h2>Tenant-safe delegated authorization kernel</h2><p>First tagged Core release with the public Go kernel, PostgreSQL adapter and migrations, security model, versioned HTTP contract, operator CLI, and React Console.</p><a class="button secondary" href={`${GITHUB_URL}/releases/tag/v0.1.0`} data-cta-target="github">View tag on GitHub ↗</a></div>
        </article>
        <article class="release-card">
          <div><strong>Next</strong></div>
          <div><span>RELEASE POLICY</span><h2>Evidence before announcement.</h2><p>Future products appear here only after a public release has source or distribution evidence, documentation, security and license boundaries, and a stable canonical page.</p></div>
        </article>
      </section>
    </div>
  </main>
</BaseLayout>
