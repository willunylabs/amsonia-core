[Unit]
Description=Amsonia product and technical website
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=amsonia-core
Group=amsonia-core
ExecStart=/opt/amsonia-site/current/amsonia-static -root /opt/amsonia-site/current/site -addr 127.0.0.1:8084
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
